{
  "components" : {
    "schemas" : {
      "AccessResponse" : {
        "properties" : {
          "address" : {
            "oneOf" : [ {
              "$ref" : "#/components/schemas/ReverseResult"
            }, {
              "type" : "null"
            } ]
          },
          "at" : {
            "description" : "Local time (Europe/Budapest) whose opening hours were applied; null when none was requested",
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "categories" : {
            "items" : {
              "$ref" : "#/components/schemas/CategoryAccess"
            },
            "type" : "array"
          },
          "holiday" : {
            "description" : "Hungarian public holiday on the day of `at` (or of the transit departure), e.g. easter_monday: holiday opening hours (PH) apply where mapped; null on other days",
            "type" : [ "string", "null" ]
          },
          "mode" : {
            "enum" : [ "walk", "bike", "transit" ],
            "type" : "string"
          },
          "point" : {
            "$ref" : "#/components/schemas/LonLat"
          },
          "score" : {
            "description" : "Weighted accessibility score, 0..100",
            "format" : "double",
            "type" : "number"
          },
          "transit" : {
            "oneOf" : [ {
              "$ref" : "#/components/schemas/TransitSummary"
            }, {
              "type" : "null"
            } ]
          }
        },
        "required" : [ "categories", "mode", "point", "score" ],
        "type" : "object"
      },
      "Anchor" : {
        "properties" : {
          "lat" : {
            "format" : "double",
            "type" : "number"
          },
          "lon" : {
            "format" : "double",
            "type" : "number"
          },
          "minutes" : {
            "format" : "int32",
            "type" : "integer"
          },
          "mode" : {
            "enum" : [ "walk", "bike", "transit" ],
            "type" : "string"
          }
        },
        "required" : [ "lat", "lon", "minutes", "mode" ],
        "type" : "object"
      },
      "CategoryAccess" : {
        "properties" : {
          "category" : {
            "enum" : [ "grocery", "pharmacy", "doctor", "school", "kindergarten", "park", "transit", "food", "gym", "library" ],
            "type" : "string"
          },
          "open" : {
            "description" : "Whether the place is open at the requested time; null when no time was given or its hours are unknown",
            "type" : [ "boolean", "null" ]
          },
          "poi" : {
            "oneOf" : [ {
              "$ref" : "#/components/schemas/Poi"
            }, {
              "type" : "null"
            } ]
          },
          "score" : {
            "description" : "0..1, linear decay to 0 at 15 minutes",
            "format" : "double",
            "type" : "number"
          },
          "seconds" : {
            "description" : "Travel time to the nearest POI, null if none within 30 minutes",
            "format" : "double",
            "type" : [ "number", "null" ]
          },
          "weight" : {
            "format" : "double",
            "type" : "number"
          }
        },
        "required" : [ "category", "score", "weight" ],
        "type" : "object"
      },
      "CategoryDto" : {
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "label" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "label" ],
        "type" : "object"
      },
      "CellTimes" : {
        "description" : "Travel times of every heatmap hexagon, column by column. walk[c][i] is the walking time in seconds from hexagon h3[i] to the nearest place of categories[c]; null means not reachable within 30 minutes. The map scores hexagons from these in the browser.",
        "properties" : {
          "bike" : {
            "items" : {
              "items" : {
                "format" : "int32",
                "type" : "integer"
              },
              "type" : "array"
            },
            "type" : "array"
          },
          "categories" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "h3" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "transit" : {
            "description" : "Walking and public transport, leaving at 08:00 on a weekday; all null until computed",
            "items" : {
              "items" : {
                "format" : "int32",
                "type" : "integer"
              },
              "type" : "array"
            },
            "type" : "array"
          },
          "walk" : {
            "items" : {
              "items" : {
                "format" : "int32",
                "type" : "integer"
              },
              "type" : "array"
            },
            "type" : "array"
          }
        },
        "required" : [ "bike", "categories", "h3", "transit", "walk" ],
        "type" : "object"
      },
      "CommonGroundResponse" : {
        "properties" : {
          "anchors" : {
            "items" : {
              "$ref" : "#/components/schemas/Anchor"
            },
            "type" : "array"
          },
          "area" : {
            "description" : "GeoJSON MultiPolygon (WGS84) from which every place is reachable in its limit; null if none",
            "oneOf" : [ {
              "$ref" : "#/components/schemas/JsonNode"
            }, {
              "type" : "null"
            } ]
          },
          "areaM2" : {
            "format" : "double",
            "type" : "number"
          },
          "at" : {
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "spots" : {
            "description" : "Best-scoring spots inside the area, spread out, best first",
            "items" : {
              "$ref" : "#/components/schemas/Spot"
            },
            "type" : "array"
          }
        },
        "required" : [ "anchors", "areaM2", "spots" ],
        "type" : "object"
      },
      "DataRelease" : {
        "properties" : {
          "importedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "sourceFile" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          }
        },
        "required" : [ "importedAt", "sourceFile", "status" ],
        "type" : "object"
      },
      "DistrictScore" : {
        "properties" : {
          "bbox" : {
            "description" : "Bounding box of the district: west, south, east, north (WGS84)",
            "items" : {
              "format" : "double",
              "type" : "number"
            },
            "type" : "array"
          },
          "cells" : {
            "format" : "int64",
            "type" : "integer"
          },
          "districtId" : {
            "format" : "int64",
            "type" : "integer"
          },
          "name" : {
            "type" : "string"
          },
          "p25" : {
            "format" : "double",
            "type" : "number"
          },
          "p75" : {
            "format" : "double",
            "type" : "number"
          },
          "rank" : {
            "format" : "int32",
            "type" : "integer"
          },
          "score" : {
            "format" : "double",
            "type" : "number"
          }
        },
        "required" : [ "bbox", "cells", "districtId", "name", "p25", "p75", "rank", "score" ],
        "type" : "object"
      },
      "Feature" : {
        "properties" : {
          "geometry" : {
            "$ref" : "#/components/schemas/JsonNode",
            "description" : "GeoJSON geometry (WGS84)"
          },
          "properties" : {
            "additionalProperties" : { },
            "type" : "object"
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "geometry", "properties", "type" ],
        "type" : "object"
      },
      "FeatureCollection" : {
        "properties" : {
          "features" : {
            "items" : {
              "$ref" : "#/components/schemas/Feature"
            },
            "type" : "array"
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "features", "type" ],
        "type" : "object"
      },
      "JsonNode" : {
        "properties" : {
          "array" : {
            "type" : "boolean"
          },
          "bigDecimal" : {
            "type" : "boolean"
          },
          "bigInteger" : {
            "type" : "boolean"
          },
          "binary" : {
            "type" : "boolean"
          },
          "boolean" : {
            "type" : "boolean"
          },
          "container" : {
            "type" : "boolean"
          },
          "double" : {
            "type" : "boolean"
          },
          "embeddedValue" : {
            "type" : "boolean"
          },
          "empty" : {
            "type" : "boolean"
          },
          "float" : {
            "type" : "boolean"
          },
          "floatingPointNumber" : {
            "type" : "boolean"
          },
          "int" : {
            "type" : "boolean"
          },
          "integralNumber" : {
            "type" : "boolean"
          },
          "long" : {
            "type" : "boolean"
          },
          "missingNode" : {
            "type" : "boolean"
          },
          "nodeType" : {
            "enum" : [ "ARRAY", "BINARY", "BOOLEAN", "MISSING", "NULL", "NUMBER", "OBJECT", "POJO", "STRING" ],
            "type" : "string"
          },
          "null" : {
            "type" : "boolean"
          },
          "number" : {
            "type" : "boolean"
          },
          "object" : {
            "type" : "boolean"
          },
          "pojo" : {
            "type" : "boolean"
          },
          "short" : {
            "type" : "boolean"
          },
          "string" : {
            "type" : "boolean"
          },
          "textual" : {
            "deprecated" : true,
            "type" : "boolean"
          },
          "valueNode" : {
            "type" : "boolean"
          }
        },
        "required" : [ "array", "bigDecimal", "bigInteger", "binary", "boolean", "container", "double", "embeddedValue", "empty", "float", "floatingPointNumber", "int", "integralNumber", "long", "missingNode", "nodeType", "null", "number", "object", "pojo", "short", "string", "textual", "valueNode" ],
        "type" : "object"
      },
      "LonLat" : {
        "properties" : {
          "lat" : {
            "format" : "double",
            "type" : "number"
          },
          "lon" : {
            "format" : "double",
            "type" : "number"
          }
        },
        "required" : [ "lat", "lon" ],
        "type" : "object"
      },
      "PersonaDto" : {
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "label" : {
            "type" : "string"
          },
          "weights" : {
            "additionalProperties" : {
              "format" : "double",
              "type" : "number"
            },
            "type" : "object"
          }
        },
        "required" : [ "id", "label", "weights" ],
        "type" : "object"
      },
      "Poi" : {
        "properties" : {
          "lat" : {
            "format" : "double",
            "type" : "number"
          },
          "lon" : {
            "format" : "double",
            "type" : "number"
          },
          "name" : {
            "type" : [ "string", "null" ]
          },
          "openingHours" : {
            "description" : "OSM opening_hours tag as mapped, if any",
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "lat", "lon" ],
        "type" : "object"
      },
      "ReverseResult" : {
        "properties" : {
          "distanceM" : {
            "format" : "double",
            "type" : "number"
          },
          "label" : {
            "type" : "string"
          },
          "lat" : {
            "format" : "double",
            "type" : "number"
          },
          "lon" : {
            "format" : "double",
            "type" : "number"
          },
          "sublabel" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "distanceM", "label", "lat", "lon" ],
        "type" : "object"
      },
      "SearchResult" : {
        "properties" : {
          "category" : {
            "type" : [ "string", "null" ]
          },
          "kind" : {
            "type" : "string"
          },
          "label" : {
            "type" : "string"
          },
          "lat" : {
            "format" : "double",
            "type" : "number"
          },
          "lon" : {
            "format" : "double",
            "type" : "number"
          },
          "sublabel" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "kind", "label", "lat", "lon" ],
        "type" : "object"
      },
      "Spot" : {
        "properties" : {
          "address" : {
            "oneOf" : [ {
              "$ref" : "#/components/schemas/ReverseResult"
            }, {
              "type" : "null"
            } ]
          },
          "lat" : {
            "format" : "double",
            "type" : "number"
          },
          "lon" : {
            "format" : "double",
            "type" : "number"
          },
          "score" : {
            "description" : "Accessibility score of the spot's hexagon for the requested profile, 0..100",
            "format" : "double",
            "type" : "number"
          },
          "seconds" : {
            "description" : "Travel time to each place, in the order of the request, seconds",
            "items" : {
              "format" : "double",
              "type" : "number"
            },
            "type" : "array"
          }
        },
        "required" : [ "lat", "lon", "score", "seconds" ],
        "type" : "object"
      },
      "TransitSummary" : {
        "properties" : {
          "departure" : {
            "format" : "date-time",
            "type" : "string"
          },
          "stopsReached" : {
            "description" : "Stops reached within the time budget, on foot or by public transport",
            "format" : "int32",
            "type" : "integer"
          },
          "tripsRunning" : {
            "description" : "Trips running on the service day; 0 means no timetable for that day",
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "departure", "stopsReached", "tripsRunning" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "15-minute city accessibility for Budapest: isochrones, scores, search.",
    "license" : {
      "name" : "Map data © OpenStreetMap contributors, ODbL",
      "url" : "https://www.openstreetmap.org/copyright"
    },
    "title" : "Reach15 API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/access" : {
      "get" : {
        "operationId" : "access",
        "parameters" : [ {
          "in" : "query",
          "name" : "lon",
          "required" : true,
          "schema" : {
            "format" : "double",
            "maximum" : 180.0,
            "minimum" : -180.0,
            "type" : "number"
          }
        }, {
          "in" : "query",
          "name" : "lat",
          "required" : true,
          "schema" : {
            "format" : "double",
            "maximum" : 90.0,
            "minimum" : -90.0,
            "type" : "number"
          }
        }, {
          "in" : "query",
          "name" : "mode",
          "required" : false,
          "schema" : {
            "default" : "walk",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "persona",
          "required" : false,
          "schema" : {
            "default" : "balanced",
            "type" : "string"
          }
        }, {
          "description" : "Custom weights, e.g. grocery:3,park:1 (overrides persona)",
          "in" : "query",
          "name" : "weights",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Local time in Budapest, e.g. 2026-11-22T20:00: only places open then count (unknown hours count as open), and public transport departs then (default: now)",
          "in" : "query",
          "name" : "at",
          "required" : false,
          "schema" : {
            "format" : "date-time",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AccessResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Accessibility of a point: nearest POI per category and weighted score",
        "tags" : [ "geo-controller" ]
      }
    },
    "/api/v1/categories" : {
      "get" : {
        "operationId" : "categories",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/CategoryDto"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "POI categories",
        "tags" : [ "geo-controller" ]
      }
    },
    "/api/v1/cells" : {
      "get" : {
        "operationId" : "cells",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CellTimes"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Travel times of every heatmap hexagon (the inputs of the map's colours)",
        "tags" : [ "geo-controller" ]
      }
    },
    "/api/v1/common-ground" : {
      "get" : {
        "description" : "Each place is lon,lat,mode,minutes (mode walk, bike or transit; 1..45 minutes), separated by semicolons, e.g. 19.0402,47.4979,transit,30;19.0700,47.5100,bike,15. Times are from home to the place (by public transport: from the place, leaving at `at`). Spots are the best-scoring hexagons inside.",
        "operationId" : "commonGround",
        "parameters" : [ {
          "in" : "query",
          "name" : "places",
          "required" : true,
          "schema" : {
            "maxLength" : 400,
            "minLength" : 7,
            "type" : "string"
          }
        }, {
          "description" : "Travel mode the spots are scored for (walk or bike)",
          "in" : "query",
          "name" : "mode",
          "required" : false,
          "schema" : {
            "default" : "walk",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "persona",
          "required" : false,
          "schema" : {
            "default" : "balanced",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "weights",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "at",
          "required" : false,
          "schema" : {
            "format" : "date-time",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "default" : 5,
            "format" : "int32",
            "maximum" : 10,
            "minimum" : 1,
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CommonGroundResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Where should we live? The area from which every place can be reached in its own limit",
        "tags" : [ "geo-controller" ]
      }
    },
    "/api/v1/districts/ranking" : {
      "get" : {
        "operationId" : "districtRanking",
        "parameters" : [ {
          "in" : "query",
          "name" : "mode",
          "required" : false,
          "schema" : {
            "default" : "walk",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "persona",
          "required" : false,
          "schema" : {
            "default" : "balanced",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "weights",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/DistrictScore"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Districts ranked by mean accessibility score",
        "tags" : [ "geo-controller" ]
      }
    },
    "/api/v1/isochrone" : {
      "get" : {
        "operationId" : "isochrone",
        "parameters" : [ {
          "in" : "query",
          "name" : "lon",
          "required" : true,
          "schema" : {
            "format" : "double",
            "maximum" : 180.0,
            "minimum" : -180.0,
            "type" : "number"
          }
        }, {
          "in" : "query",
          "name" : "lat",
          "required" : true,
          "schema" : {
            "format" : "double",
            "maximum" : 90.0,
            "minimum" : -90.0,
            "type" : "number"
          }
        }, {
          "in" : "query",
          "name" : "mode",
          "required" : false,
          "schema" : {
            "default" : "walk",
            "type" : "string"
          }
        }, {
          "description" : "Comma separated limits in minutes, each 1..30",
          "in" : "query",
          "name" : "minutes",
          "required" : false,
          "schema" : {
            "default" : [ 5, 10, 15 ],
            "items" : {
              "format" : "int32",
              "type" : "integer"
            },
            "type" : "array"
          }
        }, {
          "description" : "Departure by public transport, local time in Budapest (default: now)",
          "in" : "query",
          "name" : "at",
          "required" : false,
          "schema" : {
            "format" : "date-time",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeatureCollection"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Isochrones: the area reachable within each time limit, as GeoJSON",
        "tags" : [ "geo-controller" ]
      }
    },
    "/api/v1/meta" : {
      "get" : {
        "operationId" : "meta",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DataRelease"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The data release currently served",
        "tags" : [ "geo-controller" ]
      }
    },
    "/api/v1/personas" : {
      "get" : {
        "operationId" : "personas",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/PersonaDto"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
